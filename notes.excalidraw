      "updated": 1792841351307,
      "link": null,
      "locked": false,
      "text": "\n\nsort(c.begin(), c.end()) // O(n logn)\nsort(c.begin(), c.end(), greater<int>())\n\nbinary_search(v.begin(), v.end(), item)  => true/false\nlower_bound(v.begin(), v.end(), item)\n    -v.begin()  => return position // O(log n)\n\n// for linear search\nauto it = find(c.begin(), c.end(),item) \n    if (it != c.end())\n    cout << \"Index: \" << (it - c.begin()) << \"\\n\";\nelse\n    cout << \"Not found\\n\";\n\nreverse(c.begin(), c.end())\n\naccumulate(first,  last, init)\n",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\nsort(c.begin(), c.end()) // O(n logn)\nsort(c.begin(), c.end(), greater<int>())\n\nbinary_search(v.begin(), v.end(), item)  => true/false\nlower_bound(v.begin(), v.end(), item)\n    -v.begin()  => return position // O(log n)\n\n// for linear search\nauto it = find(c.begin(), c.end(),item) \n    if (it != c.end())\n    cout << \"Index: \" << (it - c.begin()) << \"\\n\";\nelse\n    cout << \"Not found\\n\";\n\nreverse(c.begin(), c.end())\n\naccumulate(first,  last, init)\n",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
