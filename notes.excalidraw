      "link": null,
      "locked": false,
      "text": "#include <array>\n#include <vector>\n#include <deque>\n#include <set>\n#include <algorithm>\n#include <numeric>\n\n#include <unordered_map>\ncount(key), \ncontains(key)\nerase(key)\nitem.first, \nitem.second",
